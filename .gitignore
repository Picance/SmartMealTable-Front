# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript compiled files (should not be committed in src)
src/**/*.js
src/**/*.d.ts
!src/vite-env.d.ts
!src/styled.d.ts
src/**/*.js.map
src/**/*.d.ts.map

# tsc -b output of vite.config.ts (Vite reads .js before .ts, which drops the PWA plugin)
/vite.config.js
/vite.config.d.ts
/tsconfig.node.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
